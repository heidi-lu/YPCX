{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "test",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/python",
      "args": ["-m", "pytest", "-q"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/ruff",
      "args": ["check", "."],
      "problemMatcher": []
    }
  ]
}
