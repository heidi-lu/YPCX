{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "test",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/python",
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/ruff",
      "args": [
        "check",
        "."
      ],
      "problemMatcher": []
    },
    {
      "label": "dev: backend",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/uvicorn",
      "args": [
        "main:app",
        "--reload",
        "--reload-exclude",
        "'venv/**'",
        "--reload-exclude",
        "'.venv/**'",
        "--reload-exclude",
        "'**/__pycache__/**'",
        "--reload-exclude",
        "'*.db'",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "dev: market",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/uvicorn",
      "args": [
        "market_module.app:app",
        "--reload",
        "--reload-exclude",
        "'venv/**'",
        "--reload-exclude",
        "'.venv/**'",
        "--reload-exclude",
        "'**/__pycache__/**'",
        "--reload-exclude",
        "'*.db'",
        "--port",
        "8001"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "dev: start",
      "type": "shell",
      "command": "echo \"启动 backend:8000 + market:8001\"",
      "dependsOn": [
        "dev: backend",
        "dev: market"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    }
  ]
}
