# Copy to .env and fill in real keys. Keep this file ASCII-only.
MAIN_LLM_API_KEY=
MAIN_LLM_BASE_URL=https://api.deepseek.com
MAIN_LLM_MODEL=deepseek-chat

SEARCH_API_KEY=
SEARCH_BASE_URL=https://api.deepseek.com/v1/tools/search

MARKET_LLM_API_KEY=
MARKET_LLM_BASE_URL=https://api.deepseek.com
MARKET_LLM_MODEL=deepseek-chat

VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-plus

# Optional; default is ./drug_agent.db next to this project.
# DATABASE_URL=sqlite:////absolute/path/to/drug_agent.db

# Optional Redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

LLM_MAX_CONCURRENCY=3
SEARCH_MAX_CONCURRENCY=5
HTTP_RETRY=2
GARBAGE_RATIO_THRESHOLD=0.2
